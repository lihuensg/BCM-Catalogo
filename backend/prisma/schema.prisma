generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum SaleMode {
  IN_STOCK
  MADE_TO_ORDER
}

enum Availability {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
  CHECK_AVAILABILITY
  MADE_TO_ORDER
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  OPTION
}

enum BannerPlacement {
  HOME_HERO
  HOME_SECONDARY
  CATALOG_TOP
}

model AdminUser {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(160)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @db.VarChar(512)
  active       Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  sessions     AdminSession[]
}

model AdminSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String   @unique @db.Char(64)
  adminId   String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([adminId])
  @@index([expiresAt])
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(160)
  slug        String   @unique @db.VarChar(180)
  description String?
  imageUrl    String?
  active      Boolean  @default(false)
  sortOrder   Int      @default(0)
  parentId    String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  attributes  CategoryAttribute[]

  @@index([parentId, active, sortOrder])
}

model Brand {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(160)
  slug        String   @unique @db.VarChar(180)
  description String?
  logoUrl     String?
  active      Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  products    Product[]
}

model Product {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String       @db.VarChar(200)
  slug             String       @unique @db.VarChar(220)
  sku              String?      @unique @db.VarChar(100)
  shortDescription String       @db.VarChar(500)
  fullDescription  String?
  categoryId       String       @db.Uuid
  brandId          String?      @db.Uuid
  price            Decimal?     @db.Decimal(18, 2)
  compareAtPrice   Decimal?     @db.Decimal(18, 2)
  showPrice        Boolean      @default(false)
  saleMode         SaleMode     @default(IN_STOCK)
  availability     Availability @default(CHECK_AVAILABILITY)
  active           Boolean      @default(false)
  featured         Boolean      @default(false)
  onSale           Boolean      @default(false)
  newArrival       Boolean      @default(false)
  sortOrder        Int          @default(0)
  publishedAt      DateTime?     @db.Timestamptz(3)
  seoTitle         String?      @db.VarChar(200)
  seoDescription   String?      @db.VarChar(500)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  category         Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  brand            Brand?       @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  images           ProductImage[]
  attributeValues  ProductAttributeValue[]

  // Composite target preserves category membership of attribute values.
  @@unique([id, categoryId])
  @@index([categoryId, active, sortOrder, id])
  @@index([brandId, active, sortOrder, id])
  @@index([active, sortOrder, id])
  @@index([active, availability])
  @@index([active, publishedAt, id])
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @db.Uuid
  url       String
  altText   String   @db.VarChar(300)
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([productId, sortOrder, id])
  // Partial UNIQUE(productId) WHERE isPrimary is in migration SQL.
}

model AttributeDefinition {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String            @db.VarChar(160)
  slug       String            @unique @db.VarChar(180)
  dataType   AttributeDataType
  unit       String?           @db.VarChar(40)
  filterable Boolean           @default(false)
  active     Boolean           @default(false)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  categories CategoryAttribute[]
  options    AttributeOption[]
  values     ProductAttributeValue[]

  @@unique([id, dataType])
}

model AttributeOption {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attributeId String            @db.Uuid
  dataType    AttributeDataType @default(OPTION)
  label       String            @db.VarChar(160)
  value       String            @db.VarChar(160)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  attribute   AttributeDefinition @relation(fields: [attributeId, dataType], references: [id, dataType], onDelete: Restrict, onUpdate: Restrict)
  values      ProductAttributeValue[]

  @@unique([attributeId, value])
  @@unique([id, attributeId])
}

model CategoryAttribute {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String   @db.Uuid
  attributeId String   @db.Uuid
  required    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  values      ProductAttributeValue[]

  @@unique([categoryId, attributeId])
  @@index([attributeId])
}

model ProductAttributeValue {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String            @db.Uuid
  categoryId   String            @db.Uuid
  attributeId  String            @db.Uuid
  dataType     AttributeDataType
  textValue    String?
  numberValue  Decimal?          @db.Decimal(24, 6)
  booleanValue Boolean?
  optionId     String?           @db.Uuid
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  product      Product           @relation(fields: [productId, categoryId], references: [id, categoryId], onDelete: Cascade, onUpdate: Restrict)
  categoryAttribute CategoryAttribute @relation(fields: [categoryId, attributeId], references: [categoryId, attributeId], onDelete: Restrict, onUpdate: Restrict)
  attribute    AttributeDefinition @relation(fields: [attributeId, dataType], references: [id, dataType], onDelete: Restrict, onUpdate: Restrict)
  option       AttributeOption?  @relation(fields: [optionId, attributeId], references: [id, attributeId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([productId, attributeId])
  @@index([categoryId, attributeId])
  @@index([attributeId, numberValue])
  @@index([attributeId, optionId])
  @@index([optionId, attributeId])
}

model Banner {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String?         @db.VarChar(200)
  subtitle       String?         @db.VarChar(500)
  imageUrl       String
  mobileImageUrl String?
  ctaText        String?         @db.VarChar(100)
  ctaHref        String?
  placement      BannerPlacement
  active         Boolean         @default(false)
  sortOrder      Int             @default(0)
  startsAt       DateTime?        @db.Timestamptz(3)
  endsAt         DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([placement, active, sortOrder])
}

model SiteSettings {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singleton               Boolean  @unique @default(true)
  siteName                String   @db.VarChar(160)
  whatsappNumber          String?  @db.VarChar(15)
  whatsappMessageTemplate String?
  instagramUrl            String?
  heroTitle               String?  @db.VarChar(200)
  heroSubtitle            String?  @db.VarChar(500)
  defaultSeoTitle         String   @db.VarChar(200)
  defaultSeoDescription   String   @db.VarChar(500)
  defaultOgImageUrl       String?
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}
