NODE_ENV=development
HOST=127.0.0.1
PORT=4100
CORS_ORIGINS=http://localhost:3000
# Complete with your own PostgreSQL connection. Never expose this in frontend.
DATABASE_URL=

# Dedicated disposable integration database; never use production.
TEST_DATABASE_URL=
# Optional structural JSON input, relative to backend/. Empty means no seed writes.
SEED_DATA_FILE=
# Optional idempotent demo catalog JSON, relative to backend.
SEED_CATALOG_FILE=

# Absolute session expiration in seconds (300..604800); default 8 hours.
SESSION_TTL_SECONDS=28800
# Development-only admin seed. All three are required when any is set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional frontend cache revalidation. Configure both or neither.
FRONTEND_REVALIDATE_URL=
REVALIDATION_SECRET=
